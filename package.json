{
  "name": "football-bp-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "start:lan": "PORT=3000 node server/server.js",
    "test": "node --test tests/*.test.js",
    "posters:html": "echo Already generated at posters/posters.html",
    "posters:pptx": "node posters/generate-pptx.mjs",
